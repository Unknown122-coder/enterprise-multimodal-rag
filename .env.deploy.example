# Deployment-only settings, read by scripts/deploy_space.py on top of .env.
# Copy to .env.deploy (gitignored). Never commit the real file.

# Hugging Face: a WRITE token from https://huggingface.co/settings/tokens
HF_TOKEN=
# Space to create or update, and the private dataset repo that holds artifacts.
HF_SPACE=your-username/emrag
HF_DATASET_REPO=your-username/emrag-store

# Qdrant Cloud free cluster, from https://cloud.qdrant.io (Clusters > your cluster)
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.region.cloud.qdrant.io:6333
QDRANT_API_KEY=

# Generated on first deploy if left empty.
HF_WEBHOOK_SECRET=

# Google Cloud Run (scripts/deploy_cloud_run.py): the project ID (not the name)
# and a region. asia-south1 is Mumbai; us-central1 keeps outbound data inside the
# always-free allowance.
GCP_PROJECT=
GCP_REGION=asia-south1
# Optional: service name and instance cap (default emrag, 1).
CLOUD_RUN_SERVICE=emrag
