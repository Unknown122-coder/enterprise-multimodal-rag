# ----- app -----
APP_ENV=dev                       # dev | prod
LOG_LEVEL=INFO
LOG_QUERY_TEXT=false              # true logs raw question text (PII risk)
RETRIEVAL_DEBUG=false             # true adds a `debug` block to /v1/query responses
CORS_ORIGINS=                     # comma separated, empty = none

# ----- vector store -----
VECTOR_BACKEND=qdrant             # qdrant | pinecone
COLLECTION_NAME=chunks_v1
# http://host:6333 for a server or cloud cluster; local://<dir> for an on-disk
# store (single process, no container); :memory: for tests.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_DENSE=emrag-dense-v1
PINECONE_INDEX_SPARSE=emrag-sparse-v1

# ----- LLM providers (free tiers) -----
GROQ_API_KEY=
GEMINI_API_KEY=

# ----- artifact / registry store -----
ARTIFACT_BACKEND=local            # local | hf
ARTIFACT_LOCAL_ROOT=./var/store
HF_TOKEN=
HF_DATASET_REPO=                  # e.g. your-org/emrag-store
HF_WEBHOOK_SECRET=

# ----- models -----
EMBED_BACKEND=fastembed           # fastembed (default) | gemini (small hosts) | deterministic (tests)
EMBED_MODEL=BAAI/bge-base-en-v1.5
EMBED_DIM=768
SPARSE_MODEL=Qdrant/bm25
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_ENABLED=true
FASTEMBED_CACHE_PATH=/app/models
USE_DOCLING=false                 # true only in the ingest environment

# ----- retrieval / generation tuning -----
RETRIEVAL_GATE_TAU=0.15
CANDIDATES_K=40
TOP_K=8
EVIDENCE_TOKEN_BUDGET=2500
DEFAULT_DEADLINE_MS=4500
QUOTE_MATCH_THRESHOLD=90

# ----- auth -----
TENANTS_JSON=                     # JSON array of tenants; see configs/tenants.example.yaml
JWT_HS256_SECRET=
JWT_JWKS_URL=
JWT_AUDIENCE=emrag
ALLOW_DEV_ANON=true               # dev only: unauthenticated access as tenant "demo"

# ----- limits -----
MAX_UPLOAD_MB=50
MAX_PAGES_FULL=500
MAX_PAGES_LITE=20
RATE_LIMIT_QUERY=60/minute
RATE_LIMIT_UPLOAD=10/minute

# ----- optional -----
VT_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
